# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-permissions (DMY-42): opt in ONLY to the permission handlers we
# actually request — Camera and Microphone for the WebRTC baby-monitor stream,
# Notifications for background cry/motion alerts. Each handler is a separate pod,
# so unused ones (and their privacy-sensitive frameworks) are not linked, which
# keeps the binary smaller and avoids App Store review questions about
# capabilities we don't use.
permissions_path = File.join(
  File.dirname(`node --print "require.resolve('react-native-permissions/package.json')"`.strip),
  'scripts/setup.rb',
)
require permissions_path

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

setup_permissions(%w[Camera Microphone Notifications])

target 'MobileBabysitter' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
