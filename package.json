{
  "name": "MobileBabysitter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "e2e:web": "playwright test",
    "e2e:native:build": "detox build -c ios.sim.debug",
