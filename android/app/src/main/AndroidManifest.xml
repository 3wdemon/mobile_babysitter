<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Baby-monitor runtime permissions (DMY-42). Requested on the onboarding
      Permissions screen via react-native-permissions:
        CAMERA            — live video of the baby, streamed P2P / E2E encrypted.
        RECORD_AUDIO      — two-way audio + on-device cry detection.
        POST_NOTIFICATIONS — background cry/motion alerts (Android 13+, API 33).
      All media stays on-device / peer-to-peer; nothing is uploaded to a cloud.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Background-audio foreground service (DMY-23). The parent-unit keeps the
      remote monitor audio playing while the app is backgrounded / the screen is
      locked via a plain Foreground Service (NOT ConnectionService — see
      AudioForegroundService.kt for the rationale; mirrors the iOS DMY-48 decision
      to drop CallKit). Android 14+ requires the foregroundServiceType-specific
      permissions in addition to the umbrella FOREGROUND_SERVICE one:
        FOREGROUND_SERVICE             — declare any foreground service.
        FOREGROUND_SERVICE_MICROPHONE  — two-way talk captures the parent mic.
        FOREGROUND_SERVICE_MEDIA_PLAYBACK — continuous remote baby-audio playback.
      POST_NOTIFICATIONS (declared above for alerts, DMY-42) also covers the
      service's persistent notification.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      Local-network discovery permissions (DMY-7). Used by react-native-zeroconf
      (Android NSD) so the parent phone can find the baby unit over mDNS/Bonjour
      on the same Wi-Fi WITHOUT scanning a QR code:
        CHANGE_WIFI_MULTICAST_STATE — acquire a multicast lock so the device
          receives mDNS multicast packets (NSD does not work reliably without it).
        ACCESS_NETWORK_STATE / ACCESS_WIFI_STATE — observe Wi-Fi/network state to
          gate discovery to the local network.
      Discovery is local-only; nothing is uploaded to a cloud.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-feature
      android:name="android.hardware.camera"
      android:required="false" />
    <uses-feature
      android:name="android.hardware.microphone"
      android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true"
        android:theme="@style/BootTheme">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        Background-audio foreground service (DMY-23). foregroundServiceType
        declares BOTH microphone (two-way talk) and mediaPlayback (remote audio)
        as required on Android 14+; the service is not exported (started only from
        within the app via AudioForegroundModule).
      -->
      <service
        android:name=".AudioForegroundService"
        android:exported="false"
        android:foregroundServiceType="microphone|mediaPlayback" />
    </application>
</manifest>
